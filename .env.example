# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=secret

# SMTP Configuration for Email Service
# Leave EMAIL_HOST empty locally: sends then fail and are logged
# as a warning rather than mailing real recipients.
EMAIL_HOST=
# 587 speaks STARTTLS, 465 speaks implicit SSL. The defaults
# assume 587; on 465 set EMAIL_USE_SSL=true and leave
# EMAIL_USE_TLS blank, which switches STARTTLS off for you.
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=
EMAIL_USE_TLS=
# Seconds to wait on the relay before giving up.
EMAIL_TIMEOUT=10
# The address mail is sent from.
EMAIL_FROM=noreply@akvo.org

# Frontend Domain
WEBDOMAIN=http://localhost:3000
# Frontend Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=secret

# Mapbox Access Token (get from https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_SUPPORT_EMAIL=your_support_email_here

# Storage path for file uploads and exports
STORAGE_PATH=./storage
# Secret key for signed storage URLs (defaults to SECRET_KEY if not set)
STORAGE_SECRET=secret

# Telegram Notification Settings (fallback defaults; DB settings override these)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERVISOR_GROUP_ID=
TELEGRAM_ENUMERATOR_GROUP_ID=
# Delivery retry bounds. MAX_ATTEMPTS caps how many times an
# undelivered notification is retried; COOLDOWN_MINUTES is both
# the sweep interval and the minimum gap between two attempts on
# one audit, which is what gives the retry its backoff.
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_RETRY_COOLDOWN_MINUTES=5
